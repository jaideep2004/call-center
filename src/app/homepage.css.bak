/* ═══════════════════════════════════════════════════════════════
   COVERAGE CALLS — PREMIUM HOMEPAGE
   Aligned to the approved luxury dark-purple mockup + animation spec.
   Motion is GSAP-driven; CSS here defines the resting design.
   ═══════════════════════════════════════════════════════════════ */

.homepage {
  /* DESIGN.md Shared System — synced with src/styles/tokens.css */
  --hp-bg: #080510;
  --hp-bg-hero: #07040d;
  --hp-bg-alt: #0d0618;
  --hp-section: #1a1033;
  --hp-surface: #21143d;
  --hp-elevated: #2a184c;
  --hp-card: #22153f;
  --hp-card-hover: #2c1a4e;
  --hp-primary: #7a3ef2;
  --hp-primary-hover: #6b2fe6;
  --hp-accent: #a855f7;
  --hp-accent-light: #c084fc;
  --hp-heading: #fafafc;
  --hp-body: #d8d2e8;
  --hp-secondary: #b8aecb;
  --hp-muted: #9a90b5;
  --hp-glow: rgba(168, 85, 247, 0.28);
  --hp-soft-glow: rgba(124, 58, 237, 0.18);
  --hp-white-glow: rgba(255, 255, 255, 0.08);
  --hp-hero-ambient: rgba(168, 85, 247, 0.35);
  --hp-spotlight: #f6e7ff;
  /* DESIGN.md — Poppins everywhere */
  --sans: Poppins, ui-sans-serif, system-ui, sans-serif;
  --serif: Poppins, ui-sans-serif, system-ui, sans-serif;

  background: var(--hp-bg, #080510);
  color: var(--hp-body);
  font-family: var(--sans);
  color-scheme: dark;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
}

.homepage :where(h1, h2, h3, h4) {
  font-family: var(--serif);
  color: var(--hp-heading);
  text-wrap: balance;
}

.homepage a {
  color: inherit;
  text-decoration: none;
}

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0 0 0 0);
  white-space: nowrap;
  border: 0;
}

.skip-link {
  position: fixed;
  top: -60px;
  left: 16px;
  z-index: 400;
  padding: 10px 16px;
  border-radius: 8px;
  background: var(--hp-elevated);
  border: 1px solid var(--hp-accent);
  color: var(--hp-heading);
  font-size: 13px;
  transition: top 0.2s ease;
}

.skip-link:focus-visible {
  top: 16px;
}

/* ── Shared: section chrome ─────────────────────────────────── */

.section-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin: 0 0 18px;
  font: 600 12px var(--sans);
  letter-spacing: 2.2px;
  text-transform: uppercase;
  color: var(--hp-accent-light);
}

.section-eyebrow::before {
  content: "";
  width: 22px;
  height: 1.5px;
  background: linear-gradient(90deg, var(--hp-accent), transparent);
}

.section-heading {
  margin: 0;
  font: 600 clamp(34px, 4.6vw, 62px) / 1.05 var(--serif);
  letter-spacing: -0.035em;
}

.section-heading em {
  font-style: normal;
  background: linear-gradient(100deg, var(--hp-accent-light), var(--hp-primary));
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

/* ── Buttons ────────────────────────────────────────────────── */

.cc-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  padding: 13px 24px;
  border-radius: 9px;
  border: 1px solid transparent;
  font: 600 15px var(--sans);
  cursor: pointer;
  white-space: nowrap;
  transition:
    background-color 0.2s ease,
    border-color 0.2s ease,
    box-shadow 0.25s ease,
    transform 0.2s ease,
    color 0.2s ease;
}

.cc-btn-lg {
  padding: 15px 28px;
  font-size: 15.5px;
}

.cc-btn:focus-visible {
  outline: 2px solid var(--hp-accent-light);
  outline-offset: 3px;
}

.cc-btn-primary {
  background: linear-gradient(135deg, var(--hp-primary), var(--hp-accent));
  color: #fff;
  box-shadow:
    0 10px 30px rgba(122, 62, 242, 0.32),
    inset 0 1px 0 rgba(255, 255, 255, 0.18);
}

.cc-btn-primary:hover {
  background: linear-gradient(135deg, var(--hp-primary-hover), var(--hp-accent));
  transform: translateY(-1px);
  box-shadow:
    0 14px 38px rgba(122, 62, 242, 0.42),
    inset 0 1px 0 rgba(255, 255, 255, 0.2);
}

.cc-btn-ghost {
  background: rgba(255, 255, 255, 0.04);
  border-color: rgba(255, 255, 255, 0.14);
  color: var(--hp-heading);
}

.cc-btn-ghost:hover {
  background: rgba(255, 255, 255, 0.09);
  border-color: rgba(255, 255, 255, 0.28);
}

.cc-btn-outline {
  background: transparent;
  border-color: rgba(168, 85, 247, 0.45);
  color: var(--hp-heading);
}

.cc-btn-outline:hover {
  background: rgba(168, 85, 247, 0.1);
  border-color: var(--hp-accent);
}

.cc-btn-light {
  background: #fafafc;
  color: var(--hp-primary);
  box-shadow: 0 12px 34px rgba(20, 10, 38, 0.35);
}

.cc-btn-light:hover {
  background: #fff;
  transform: translateY(-1px);
}

.cc-btn-outline-light {
  background: rgba(255, 255, 255, 0.06);
  border-color: rgba(255, 255, 255, 0.35);
  color: #fff;
}

.cc-btn-outline-light:hover {
  background: rgba(255, 255, 255, 0.12);
  border-color: rgba(255, 255, 255, 0.6);
}

.play-badge {
  display: inline-grid;
  place-items: center;
  width: 26px;
  height: 26px;
  border-radius: 50%;
  background: currentColor;
  color: var(--hp-bg);
  font-size: 10px;
  padding-left: 2px;
}

/* ── Logo ───────────────────────────────────────────────────── */

.logo {
  display: inline-flex;
  align-items: center;
  gap: 11px;
}

.logo-mark-svg {
  filter: drop-shadow(0 0 12px rgba(168, 85, 247, 0.5));
}

.logo-word {
  font: 700 15px var(--sans);
  letter-spacing: 2.4px;
  color: var(--hp-heading);
  white-space: nowrap;
}

/* ── Navbar (§05) ───────────────────────────────────────────── */

.site-nav-wrap {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: var(--z-sticky);
  display: flex;
  justify-content: center;
  padding: 20px 24px 0;
  pointer-events: none;
}

.site-nav {
  pointer-events: auto;
  width: min(1180px, 100%);
  min-height: 54px;
  border-radius: 16px;
  border: 1px solid rgba(255, 255, 255, 0.07);
  background: rgba(20, 10, 38, 0.45);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  transition:
    background-color 0.35s ease,
    border-color 0.35s ease,
    backdrop-filter 0.35s ease,
    box-shadow 0.35s ease;
}

.is-scrolled .site-nav {
  background: rgba(22, 12, 42, 0.78);
  border-color: rgba(168, 85, 247, 0.22);
  backdrop-filter: blur(22px);
  -webkit-backdrop-filter: blur(22px);
  box-shadow: 0 18px 50px rgba(0, 0, 0, 0.45);
}

.is-scrolled .site-nav-wrap {
  padding-top: 12px;
}

.site-nav-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  padding: 13px 22px;
}

.site-nav-links {
  display: flex;
  align-items: center;
  gap: 4px;
}

.site-nav-link {
  padding: 8px 13px;
  border-radius: 8px;
  font-size: 14px;
  font-weight: 500;
  color: var(--hp-secondary);
  transition: color 0.2s ease, background-color 0.2s ease;
}

.site-nav-link:hover {
  color: var(--hp-heading);
  background: rgba(255, 255, 255, 0.05);
}

.site-nav-link:focus-visible,
.site-nav-login:focus-visible,
.site-nav-cta:focus-visible {
  outline: 2px solid var(--hp-accent-light, #c084fc);
  outline-offset: 3px;
}

.site-nav-chev,
.nav-chevron {
  font-size: 10px;
  color: var(--hp-muted, #9a90b5);
  margin-left: 4px;
  line-height: 1;
}

.site-nav-logo {
  display: inline-flex;
  align-items: center;
  gap: 11px;
  text-decoration: none;
}

.site-nav-auth {
  display: flex;
  align-items: center;
  gap: 18px;
}

.site-nav-login {
  font-size: 14px;
  font-weight: 500;
  color: var(--hp-body);
  transition: color 0.2s ease;
}

.site-nav-login:hover {
  color: var(--hp-heading);
}

.site-nav-cta {
  padding: 10px 20px;
  border-radius: 9px;
  font: 600 14px var(--sans);
  color: #fff;
  white-space: nowrap;
  background: linear-gradient(135deg, var(--hp-primary), var(--hp-accent));
  box-shadow: 0 8px 24px rgba(122, 62, 242, 0.35);
  transition: filter 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
}

.site-nav-cta:hover {
  filter: brightness(1.08);
  transform: translateY(-1px);
  box-shadow: 0 12px 30px rgba(122, 62, 242, 0.45);
}

.site-nav-cta:focus-visible {
  outline: 2px solid var(--hp-accent-light);
  outline-offset: 3px;
}

/* ── Hero (§06) — DESIGN.md:36-46 layout, DESIGN.md:48-70 ambient, DESIGN.md:72-102 type/CTAs ── */

.hero {
  position: relative;
  padding: 168px clamp(24px, 6vw, 88px) clamp(90px, 10vh, 150px);
  overflow: hidden;
}

.hero-bg {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.hero-orb {
  position: absolute;
  top: -34%;
  right: -14%;
  width: 760px;
  height: 760px;
  border-radius: 50%;
  background:
    radial-gradient(circle at 42% 38%, rgba(246, 231, 255, 0.18), transparent 30%),
    radial-gradient(circle at 50% 50%, rgba(168, 85, 247, 0.35), rgba(74, 30, 140, 0.18) 55%, transparent 72%);
  filter: blur(12px);
  opacity: 0.42;
}

.hero-orb::after {
  content: "";
  position: absolute;
  inset: 16%;
  border-radius: 50%;
  border: 1.5px solid rgba(246, 231, 255, 0.18);
}

.hero-orb::before {
  content: "";
  position: absolute;
  inset: 34%;
  border-radius: 50%;
  border: 1px dashed rgba(246, 231, 255, 0.14);
}

.hero-light {
  position: absolute;
  top: 6%;
  left: -6%;
  width: 520px;
  height: 520px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(124, 58, 237, 0.22), transparent 62%);
}

.hero-spotlight {
  position: absolute;
  top: -12%;
  left: 32%;
  width: 46%;
  height: 60%;
  background: linear-gradient(180deg, var(--hp-spotlight), transparent 78%);
  opacity: 0.16;
  filter: blur(70px);
}

.hero-horizon {
  position: absolute;
  bottom: -8%;
  left: 50%;
  transform: translateX(-50%);
  width: 130%;
  height: 300px;
  background: radial-gradient(ellipse at 50% 100%, rgba(168, 85, 247, 0.4), transparent 66%);
  filter: blur(6px);
}

.hero-grid {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(168, 85, 247, 0.05) 1px, transparent 1px),
    linear-gradient(90deg, rgba(168, 85, 247, 0.05) 1px, transparent 1px);
  background-size: 74px 74px;
  mask-image: radial-gradient(ellipse at 60% 30%, black 10%, transparent 68%);
  -webkit-mask-image: radial-gradient(ellipse at 60% 30%, black 10%, transparent 68%);
}

.hero-inner {
  position: relative;
  display: grid;
  grid-template-columns: 1.02fr 1.1fr;
  align-items: center;
  gap: clamp(40px, 5vw, 84px);
  max-width: 1240px;
  margin: 0 auto;
}

/* 06.2 headline */
.hero-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  margin: 0 0 26px;
  padding: 9px 16px;
  border-radius: 9999px;
  border: 1px solid rgba(168, 85, 247, 0.35);
  background: rgba(42, 24, 76, 0.5);
  font: 600 12px var(--sans);
  letter-spacing: 2.6px;
  color: var(--hp-accent-light);
}

.eyebrow-diamond {
  width: 8px;
  height: 8px;
  transform: rotate(45deg);
  background: linear-gradient(135deg, var(--hp-accent-light), var(--hp-primary));
  box-shadow: 0 0 12px rgba(168, 85, 247, 0.7);
}

.hero-title {
  margin: 0;
  font: 600 clamp(44px, 5.6vw, 78px) / 1.04 var(--serif);
  letter-spacing: -0.04em;
}

.hl-line {
  display: block;
}

.hero-title em {
  font-style: normal;
  background: linear-gradient(100deg, var(--hp-spotlight) 0%, var(--hp-accent-light) 45%, var(--hp-primary) 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.hero-sub {
  max-width: 460px;
  margin: 26px 0 0;
  font-size: 17px;
  line-height: 1.72;
  color: var(--hp-secondary);
  text-wrap: pretty;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 14px;
  margin-top: 36px;
}

.hero-trust {
  display: flex;
  flex-wrap: wrap;
  gap: 6px 14px;
  margin: 16px 0 0;
  padding: 0;
  list-style: none;
}

.hero-trust li {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  color: var(--hp-muted);
}

.hero-trust svg {
  color: var(--hp-accent-light);
}

/* ── Hero product UI (§07–09) — DESIGN.md:104-110 S-curve, DESIGN.md:112-166 cards ── */

.hero-product {
  position: relative;
  min-height: 560px;
  display: grid;
  place-items: center;
}

.routing-line {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 10;
  pointer-events: none;
  overflow: visible;
}

.call-card {
  position: relative;
  z-index: 2;
  width: min(360px, 78%);
  border-radius: 16px;
  border: 1px solid rgba(255, 255, 255, 0.08);
  background: linear-gradient(160deg, rgba(42, 24, 76, 0.92), rgba(26, 16, 51, 0.96));
  box-shadow:
    0 24px 60px rgba(0, 0, 0, 0.5),
    0 0 40px rgba(168, 85, 247, 0.12),
    inset 0 1px 0 rgba(255, 255, 255, 0.06);
  backdrop-filter: blur(8px);
  padding: 16px;
}

.call-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: var(--hp-muted);
}

.call-live {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  font: 600 11px var(--sans);
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--hp-secondary);
}

.live-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #22c55e;
  box-shadow: 0 0 12px rgba(34, 197, 94, 0.8);
  transform-origin: center;
}

.call-timer {
  color: var(--hp-muted);
  font-weight: 500;
  letter-spacing: 1px;
}

.call-contact {
  display: flex;
  align-items: center;
  gap: 10px;
  margin: 12px 0 10px;
}

.call-avatar {
  display: grid;
  place-items: center;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: linear-gradient(135deg, #3b2269, #22153f);
  border: 1px solid rgba(192, 132, 252, 0.4);
  color: var(--hp-accent-light);
  font: 600 12px var(--sans);
  flex-shrink: 0;
}

.call-contact strong {
  display: block;
  font: 600 13.5px var(--sans);
  color: var(--hp-heading);
}

.call-contact small {
  display: block;
  margin-top: 2px;
  font-size: 11.5px;
  color: var(--hp-muted);
}

/* 07.2 waveform */
.waveform {
  position: relative;
  height: 42px;
  overflow: hidden;
  border-radius: 8px;
  background: rgba(20, 10, 38, 0.55);
  border: 1px solid rgba(168, 85, 247, 0.14);
}

.waveform-bars {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  gap: 2.5px;
  padding: 0 12px;
}

.waveform-bars span {
  flex: 1;
  min-width: 2px;
  max-width: 6px;
  border-radius: 2px;
  background: linear-gradient(to top, rgba(122, 62, 242, 0.4), rgba(196, 132, 252, 0.9));
}

.waveform-sweep {
  position: absolute;
  top: 0;
  bottom: 0;
  left: -45%;
  width: 45%;
  background: linear-gradient(90deg, transparent, rgba(246, 231, 255, 0.4), transparent);
  filter: blur(5px);
  pointer-events: none;
  opacity: 0.9;
}

/* pipeline status */
.call-pipeline {
  position: relative;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  margin: 12px 0 10px;
}

.pipeline-rail {
  position: absolute;
  top: 5px;
  left: 4%;
  right: 4%;
  height: 1px;
  background: repeating-linear-gradient(90deg, rgba(154, 144, 181, 0.4) 0 3px, transparent 3px 7px);
}

.pipeline-stage {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  font-size: 10px;
  letter-spacing: 0.3px;
  color: var(--hp-muted);
  white-space: nowrap;
}

.pipeline-dot {
  position: relative;
  z-index: 1;
  width: 11px;
  height: 11px;
  border-radius: 50%;
  background: var(--hp-card);
  border: 1.5px solid rgba(154, 144, 181, 0.5);
  flex-shrink: 0;
}

.pipeline-stage.active {
  color: var(--hp-accent-light);
}

.pipeline-stage.active .pipeline-dot {
  background: var(--hp-accent);
  border-color: var(--hp-accent);
  box-shadow: 0 0 12px rgba(168, 85, 247, 0.9);
}

.pipeline-stage.done .pipeline-dot {
  background: var(--hp-accent-light);
  border-color: var(--hp-accent-light);
}

/* controls */
.call-controls {
  display: flex;
  gap: 8px;
}

.call-ctl {
  flex: 1;
  padding: 9px 6px;
  border-radius: 9px;
  border: 1px solid rgba(255, 255, 255, 0.08);
  background: rgba(255, 255, 255, 0.04);
  color: var(--hp-body);
  font: 500 12px var(--sans);
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 5px;
  transition: background-color 0.15s ease, border-color 0.15s ease;
}

.call-ctl:hover {
  background: rgba(255, 255, 255, 0.09);
  border-color: rgba(255, 255, 255, 0.16);
}

.call-ctl.end {
  flex: 1.35;
  background: rgba(239, 68, 68, 0.16);
  border-color: rgba(239, 68, 68, 0.4);
  color: #fca5a5;
}

.call-ctl.end:hover {
  background: rgba(239, 68, 68, 0.26);
}

/* 09 agent card */
.agent-card {
  position: absolute;
  right: 0;
  top: 52%;
  transform: translateY(-50%);
  z-index: 4;
  width: 190px;
  padding: 14px;
  border-radius: 16px;
  border: 1px solid rgba(168, 85, 247, 0.3);
  background: linear-gradient(160deg, rgba(46, 27, 84, 0.95), rgba(30, 18, 58, 0.98));
  box-shadow:
    0 20px 50px rgba(0, 0, 0, 0.5),
    0 0 32px rgba(168, 85, 247, 0.16);
  text-align: center;
}

.agent-card.is-connected {
  border-color: rgba(192, 132, 252, 0.62);
  box-shadow:
    0 24px 60px rgba(0, 0, 0, 0.5),
    0 0 54px rgba(168, 85, 247, 0.3);
}

.agent-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}

.agent-role {
  font: 600 10px var(--sans);
  letter-spacing: 1.8px;
  text-transform: uppercase;
  color: var(--hp-heading);
  opacity: 0.85;
}

.agent-status {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font: 600 10px var(--sans);
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: var(--hp-body);
}

.online-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #22c55e;
  box-shadow: 0 0 10px rgba(34, 197, 94, 0.8);
}

.agent-photo {
  position: relative;
  width: 56px;
  height: 56px;
  margin: 10px auto 8px;
  border-radius: 50%;
  overflow: hidden;
  border: 2px solid rgba(192, 132, 252, 0.45);
  box-shadow: 0 0 16px rgba(168, 85, 247, 0.3);
}

.agent-photo img {
  object-fit: cover;
}

.agent-meta strong {
  display: block;
  font: 600 15.5px var(--sans);
  color: var(--hp-heading);
}

.agent-meta small {
  display: block;
  margin-top: 3px;
  font-size: 12px;
  color: var(--hp-muted);
}

.agent-rating {
  display: inline-block;
  margin-top: 8px;
  padding: 3px 10px;
  border-radius: 9999px;
  background: rgba(168, 85, 247, 0.14);
  border: 1px solid rgba(168, 85, 247, 0.3);
  color: #f0d9ff;
  font-size: 12px;
}

.agent-answer {
  width: 100%;
  margin-top: 16px;
  padding: 11px;
  border-radius: 10px;
  border: 1px solid var(--hp-accent);
  background: linear-gradient(135deg, var(--hp-primary), var(--hp-accent));
  color: #fff;
  font: 600 13.5px var(--sans);
  cursor: pointer;
  transition: filter 0.2s ease, box-shadow 0.25s ease;
}

.agent-answer:hover {
  filter: brightness(1.12);
  box-shadow: 0 8px 26px rgba(122, 62, 242, 0.5);
}

/* ── Trust (§10) ────────────────────────────────────────────── */

.trust {
  position: relative;
  padding: clamp(28px, 4vh, 56px) clamp(24px, 6vw, 88px);
  border-top: 1px solid rgba(255, 255, 255, 0.05);
  background: linear-gradient(180deg, rgba(20, 10, 38, 0.4), rgba(20, 10, 38, 0));
}

.trust-label {
  margin: 0 0 26px;
  text-align: center;
  font: 600 11.5px var(--sans);
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--hp-muted);
}

.trust-row {
  position: relative;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
  gap: 18px clamp(36px, 5vw, 72px);
  overflow: hidden;
  max-width: 1000px;
  margin: 0 auto;
}

.trust-sweep {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  width: 34%;
  background: linear-gradient(90deg, transparent, rgba(246, 231, 255, 0.14), transparent);
  pointer-events: none;
  opacity: 0;
}

.trust-logo {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  font: 600 15px var(--sans);
  color: rgba(216, 210, 232, 0.62);
  white-space: nowrap;
  transition: color 0.2s ease;
}

.trust-logo:hover {
  color: var(--hp-body);
}

.trust-logo svg {
  color: rgba(168, 85, 247, 0.75);
}

/* ── How it works (§11) ─────────────────────────────────────── */

.hiw {
  position: relative;
  padding: clamp(110px, 14vh, 180px) clamp(24px, 6vw, 88px);
  background: var(--hp-section);
}

.hiw-head {
  max-width: 760px;
  margin-bottom: clamp(56px, 7vw, 96px);
}.hiw-line {
	position: absolute;
	top: 49px;
	left: 0;
	height: 1.5px;
	width: 100%;
  transform-origin: left center;
  background: linear-gradient(90deg, transparent, rgba(168, 85, 247, 0.55), rgba(192, 132, 252, 0.8), rgba(168, 85, 247, 0.55), transparent);
  box-shadow: 0 0 18px rgba(168, 85, 247, 0.4);
}

.hiw-track {
  position: relative;
  padding-top: 26px;
}

.hiw-steps {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 26px;
}

.hiw-node {
  position: relative;
}

.hiw-node-top {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-bottom: 22px;
}

.hiw-icon {
  display: grid;
  place-items: center;
  width: 46px;
  height: 46px;
  border-radius: 14px;
  background: linear-gradient(160deg, rgba(42, 24, 76, 0.9), rgba(26, 16, 51, 0.9));
  border: 1px solid rgba(168, 85, 247, 0.4);
  color: var(--hp-accent-light);
  box-shadow: 0 8px 22px rgba(0, 0, 0, 0.35);
}

.hiw-num {
  font: 600 13px var(--mono);
  letter-spacing: 1.5px;
  color: var(--hp-muted);
}

.hiw-copy h3 {
  margin: 0 0 8px;
  font: 600 17px var(--sans);
  color: var(--hp-heading);
}

.hiw-copy p {
  margin: 0;
  font-size: 13.5px;
  line-height: 1.62;
  color: var(--hp-secondary);
}

/* ── Product showcase: browser (§12) ────────────────────────── */

.bp {
  position: relative;
  padding: clamp(120px, 15vh, 190px) clamp(24px, 6vw, 88px);
  overflow: hidden;
}

.bp-blob {
  position: absolute;
  right: -8%;
  top: 6%;
  width: 560px;
  height: 560px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(168, 85, 247, 0.2), transparent 62%);
  filter: blur(90px);
  pointer-events: none;
}

.bp-inner {
  position: relative;
  display: grid;
  grid-template-columns: 0.92fr 1.25fr;
  align-items: center;
  gap: clamp(40px, 5vw, 84px);
  max-width: 1240px;
  margin: 0 auto;
}

.bp-heading {
  margin-bottom: 20px;
}

.bp-heading em {
  font-style: normal;
  color: var(--hp-accent-light);
}

.bp-body {
  margin: 0 0 28px;
  font-size: 16.5px;
  line-height: 1.72;
  color: var(--hp-secondary);
  max-width: 440px;
  text-wrap: pretty;
}

.check-list {
  list-style: none;
  margin: 0 0 30px;
  padding: 0;
  display: grid;
  gap: 13px;
}

.check-list li {
  display: inline-flex;
  align-items: center;
  gap: 11px;
  font-size: 15px;
  color: var(--hp-body);
}

.check-list svg {
  color: var(--hp-accent-light);
  flex-shrink: 0;
}

.text-link-arrow {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font: 600 15px var(--sans);
  color: var(--hp-accent-light);
  transition: color 0.2s ease, gap 0.2s ease;
}

.text-link-arrow:hover {
  color: var(--hp-spotlight);
  gap: 12px;
}

/* browser window */
.bp-browser {
  perspective: 1200px;
  border-radius: 18px;
  border: 1px solid rgba(255, 255, 255, 0.1);
  background: linear-gradient(170deg, rgba(33, 20, 61, 0.96), rgba(20, 10, 38, 0.98));
  box-shadow:
    0 40px 100px rgba(0, 0, 0, 0.55),
    0 0 70px rgba(168, 85, 247, 0.12);
  overflow: hidden;
}

.browser-bar {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 13px 18px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  background: rgba(255, 255, 255, 0.03);
}

.traffic-lights {
  display: inline-flex;
  gap: 7px;
}

.traffic-lights i {
  width: 11px;
  height: 11px;
  border-radius: 50%;
}

.traffic-lights .red { background: #ff5f57; }
.traffic-lights .yellow { background: #febc2e; }
.traffic-lights .green { background: #28c840; }

.browser-title {
  margin-left: 8px;
  font: 500 12px var(--sans);
  color: var(--hp-muted);
  letter-spacing: 0.4px;
}

.browser-body {
  display: grid;
  grid-template-columns: 52px 1.25fr 1fr;
  min-height: 380px;
}

.browser-side {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  padding: 18px 0;
  border-right: 1px solid rgba(255, 255, 255, 0.06);
  background: rgba(255, 255, 255, 0.02);
}

.side-icon {
  display: grid;
  place-items: center;
  width: 34px;
  height: 34px;
  border-radius: 9px;
  color: var(--hp-muted);
}

.side-icon.active {
  color: var(--hp-accent-light);
  background: rgba(168, 85, 247, 0.16);
  border: 1px solid rgba(168, 85, 247, 0.3);
}

.browser-main {
  padding: 18px;
  border-right: 1px solid rgba(255, 255, 255, 0.06);
}

.call-card-mini {
  border-radius: 14px;
  border: 1px solid rgba(255, 255, 255, 0.08);
  background: rgba(26, 16, 51, 0.6);
  padding: 16px;
}

.call-card-mini .call-contact {
  margin: 14px 0 12px;
}

.call-card-mini .call-avatar {
  width: 34px;
  height: 34px;
  font-size: 11px;
}

.call-card-mini .waveform {
  height: 40px;
  margin-bottom: 12px;
}

.bp-tags {
  display: flex;
  gap: 8px;
  margin-bottom: 14px;
}

.tag {
  padding: 5px 11px;
  border-radius: 9999px;
  font: 600 11px var(--sans);
  letter-spacing: 0.3px;
}

.tag-hot {
  background: rgba(239, 68, 68, 0.14);
  border: 1px solid rgba(239, 68, 68, 0.35);
  color: #fda4af;
}

.tag-purple {
  background: rgba(168, 85, 247, 0.14);
  border: 1px solid rgba(168, 85, 247, 0.35);
  color: var(--hp-accent-light);
}

.browser-notes {
  padding: 20px;
  display: flex;
  flex-direction: column;
}

.notes-title {
  margin: 0 0 10px;
  font: 600 12px var(--sans);
  letter-spacing: 1.6px;
  text-transform: uppercase;
  color: var(--hp-muted);
}

.notes-title:not(:first-child) {
  margin-top: 20px;
}

.bp-callnotes {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  gap: 7px;
}

.bp-callnotes li {
  position: relative;
  padding-left: 15px;
  font-size: 13px;
  line-height: 1.5;
  color: var(--hp-secondary);
}

.bp-callnotes li::before {
  content: "";
  position: absolute;
  left: 2px;
  top: 8px;
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: var(--hp-accent);
  opacity: 0.7;
}

.bp-dispo {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 13px;
  border-radius: 9px;
  border: 1px solid rgba(168, 85, 247, 0.3);
  background: rgba(42, 24, 76, 0.5);
  color: var(--hp-body);
  font-size: 13px;
}

.bp-dispo-value.set {
  color: var(--hp-accent-light);
  font-weight: 600;
}

.bp-save {
  margin-top: auto;
  padding: 12px;
  border-radius: 10px;
  border: 1px solid var(--hp-accent);
  background: linear-gradient(135deg, var(--hp-primary), var(--hp-accent));
  color: #fff;
  font: 600 13.5px var(--sans);
  cursor: pointer;
  transition: filter 0.2s ease;
}

.bp-save:hover {
  filter: brightness(1.1);
}

/* ── Analytics (§13) ────────────────────────────────────────── */

.analytics {
  position: relative;
  padding: clamp(120px, 15vh, 190px) clamp(24px, 6vw, 88px);
  background: #0d0618;
  overflow: hidden;
}

.an-bg {
  position: absolute;
  left: 30%;
  top: 20%;
  width: 480px;
  height: 480px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(96, 165, 250, 0.1), transparent 62%);
  filter: blur(80px);
  pointer-events: none;
}

.an-inner {
  position: relative;
  display: grid;
  grid-template-columns: 0.92fr 1.45fr;
  align-items: start;
  gap: clamp(40px, 5vw, 84px);
  max-width: 1240px;
  margin: 0 auto;
}

.an-heading {
  margin-bottom: 18px;
}

.an-heading em {
  font-style: normal;
  color: var(--hp-accent-light);
}

.an-body {
  margin: 0 0 26px;
  font-size: 16.5px;
  line-height: 1.72;
  color: var(--hp-secondary);
  max-width: 420px;
  text-wrap: pretty;
}

.an-dash {
  display: grid;
  gap: 14px;
}

.metric-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14px;
}

.an-panel {
  border-radius: 14px;
  border: 1px solid rgba(168, 85, 247, 0.16);
  background: linear-gradient(160deg, rgba(33, 20, 61, 0.9), rgba(20, 10, 38, 0.94));
  box-shadow: 0 14px 40px rgba(0, 0, 0, 0.4);
}

.metric-card {
  padding: 18px 20px;
}

.metric-label {
  display: block;
  font: 500 11.5px var(--sans);
  letter-spacing: 1.4px;
  text-transform: uppercase;
  color: var(--hp-muted);
}

.metric-value {
  display: block;
  margin: 12px 0 9px;
  font: 600 clamp(22px, 1.8vw, 30px) / 1 var(--serif);
  letter-spacing: -0.02em;
  color: var(--hp-heading);
  font-variant-numeric: tabular-nums;
}

.metric-delta {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 11.5px;
  color: #4ade80;
}

.an-bottom {
  display: grid;
  grid-template-columns: 1.6fr 1fr;
  gap: 14px;
}

.chart-panel,
.campaigns-panel {
  padding: 20px;
}

.panel-head-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14px;
}

.panel-head-row h3,
.campaigns-panel h3 {
  margin: 0;
  font: 600 14.5px var(--sans);
  color: var(--hp-heading);
}

.chart-legend {
  display: flex;
  gap: 14px;
  font-size: 11px;
  color: var(--hp-muted);
}

.chart-legend span {
  display: inline-flex;
  align-items: center;
  gap: 6px;
}

.chart-legend i {
  width: 8px;
  height: 8px;
  border-radius: 50%;
}

.an-chart {
  width: 100%;
  height: auto;
  display: block;
}

.campaign-list {
  list-style: none;
  margin: 6px 0 0;
  padding: 0;
  display: grid;
}

.campaign-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 13px 2px;
  border-top: 1px solid rgba(255, 255, 255, 0.06);
  font-size: 13.5px;
}

.campaign-row:first-child {
  border-top: 0;
}

.campaign-name {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  color: var(--hp-body);
}

.campaign-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--hp-accent-light), var(--hp-primary));
  box-shadow: 0 0 8px rgba(168, 85, 247, 0.6);
}

.campaign-row strong {
  font: 600 13.5px var(--sans);
  color: var(--hp-heading);
  font-variant-numeric: tabular-nums;
}

/* ── Features (§14) ─────────────────────────────────────────── */

.features {
  padding: clamp(120px, 14vh, 170px) clamp(24px, 6vw, 88px);
}

.features-head {
  max-width: 720px;
  margin: 0 auto clamp(56px, 6vw, 80px);
  text-align: center;
}

.features-head .section-eyebrow {
  justify-content: center;
}

.features-head .section-eyebrow::before {
  display: none;
}

.feature-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 12px;
  max-width: 1240px;
  margin: 0 auto;
}

.feat-card {
  padding: 24px 20px;
  border-radius: 18px;
  border: 1px solid rgba(255, 255, 255, 0.08);
  background: linear-gradient(165deg, rgba(34, 21, 63, 0.85), rgba(26, 16, 51, 0.9));
  transition:
    transform 0.25s ease,
    border-color 0.25s ease,
    background-color 0.25s ease,
    box-shadow 0.3s ease;
}

.feat-card:hover {
  transform: translateY(-2px);
  border-color: rgba(168, 85, 247, 0.45);
  background: linear-gradient(165deg, rgba(44, 26, 78, 0.9), rgba(33, 20, 61, 0.94));
  box-shadow: 0 18px 44px rgba(0, 0, 0, 0.4);
}

.feat-card.featured {
  border-color: rgba(168, 85, 247, 0.75);
  background: linear-gradient(165deg, rgba(44, 26, 78, 0.92), rgba(30, 18, 58, 0.95));
  box-shadow:
    0 18px 50px rgba(0, 0, 0, 0.45),
    0 0 50px rgba(168, 85, 247, 0.22);
}

.feat-card.featured:hover {
  transform: translateY(-3px);
  border-color: var(--hp-accent);
  box-shadow:
    0 22px 60px rgba(0, 0, 0, 0.5),
    0 0 52px rgba(168, 85, 247, 0.22);
}

.feat-icon {
  display: grid;
  place-items: center;
  width: 48px;
  height: 48px;
  margin-bottom: 22px;
  border-radius: 13px;
  background: rgba(168, 85, 247, 0.13);
  border: 1px solid rgba(168, 85, 247, 0.3);
  color: var(--hp-accent-light);
  transition: box-shadow 0.3s ease;
}

.feat-card:hover .feat-icon {
  box-shadow: 0 0 20px rgba(168, 85, 247, 0.35);
}

.feat-card h3 {
  margin: 0 0 9px;
  font: 600 18px var(--sans);
  color: var(--hp-heading);
}

.feat-card p {
  margin: 0;
  font-size: 14px;
  line-height: 1.62;
  color: var(--hp-secondary);
}

/* ── Pricing (§15) ──────────────────────────────────────────── */

.pricing {
  padding: clamp(120px, 14vh, 170px) clamp(24px, 6vw, 88px);
  background: var(--hp-section);
}

.pricing-head {
  max-width: 720px;
  margin: 0 auto clamp(56px, 6vw, 80px);
  text-align: center;
}

.pricing-head .section-eyebrow {
  justify-content: center;
}

.pricing-head .section-eyebrow::before {
  display: none;
}

.plan-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 22px;
  max-width: 1080px;
  margin: 0 auto;
  align-items: stretch;
}

.plan-card {
  position: relative;
  display: flex;
  flex-direction: column;
  padding: 34px 30px;
  border-radius: 20px;
  border: 1px solid rgba(255, 255, 255, 0.09);
  background: linear-gradient(170deg, rgba(34, 21, 63, 0.9), rgba(26, 16, 51, 0.94));
  transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.3s ease;
}

.plan-card:hover {
  transform: translateY(-2px);
  border-color: rgba(168, 85, 247, 0.4);
}

.plan-card.featured {
  border: 1.5px solid rgba(168, 85, 247, 0.9);
  background: linear-gradient(170deg, rgba(46, 27, 84, 0.95), rgba(30, 18, 58, 0.97));
  box-shadow:
    0 28px 70px rgba(0, 0, 0, 0.5),
    0 0 70px rgba(168, 85, 247, 0.28);
}

.plan-card.featured:hover {
  transform: translateY(-3px);
  box-shadow:
    0 32px 80px rgba(0, 0, 0, 0.55),
    0 0 76px rgba(168, 85, 247, 0.28);
}

.plan-badge {
  position: absolute;
  top: -13px;
  right: 24px;
  padding: 6px 13px;
  border-radius: 9999px;
  background: linear-gradient(135deg, var(--hp-primary), var(--hp-accent));
  color: #fff;
  font: 700 10.5px var(--sans);
  letter-spacing: 1.6px;
  box-shadow: 0 6px 18px rgba(122, 62, 242, 0.5);
}

.plan-card h3 {
  margin: 0 0 12px;
  font: 600 16px var(--sans);
  letter-spacing: 1.8px;
  text-transform: uppercase;
  color: var(--hp-secondary);
}

.plan-price {
  margin: 0;
  font: 600 44px / 1 var(--serif);
  letter-spacing: -0.03em;
  color: var(--hp-heading);
  font-variant-numeric: tabular-nums;
}

.plan-price span {
  font: 500 15px var(--sans);
  color: var(--hp-muted);
  margin-left: 4px;
  letter-spacing: 0;
}

.plan-blurb {
  margin: 12px 0 24px;
  font-size: 13.5px;
  line-height: 1.6;
  color: var(--hp-secondary);
}

.plan-features {
  list-style: none;
  margin: 0 0 28px;
  padding: 0;
  display: grid;
  gap: 11px;
}

.plan-features li {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-size: 14px;
  color: var(--hp-body);
}

.plan-features svg {
  color: var(--hp-accent-light);
  flex-shrink: 0;
}

.plan-cta {
  margin-top: auto;
  width: 100%;
}

.plan-footnote {
  margin: 34px 0 0;
  text-align: center;
  font-size: 13.5px;
  color: var(--hp-muted);
}

/* ── Final CTA (§16) ────────────────────────────────────────── */

.cta {
  padding: clamp(100px, 12vh, 150px) clamp(24px, 6vw, 88px) clamp(120px, 14vh, 170px);
}

.cta-banner {
  position: relative;
  max-width: 1120px;
  margin: 0 auto;
  padding: clamp(64px, 9vw, 110px) clamp(28px, 6vw, 90px);
  border-radius: 30px;
  border: 1px solid rgba(192, 132, 252, 0.3);
  background:
    radial-gradient(ellipse at 50% 0%, rgba(246, 231, 255, 0.2), transparent 48%),
    radial-gradient(ellipse at 18% 100%, rgba(122, 62, 242, 0.4), transparent 55%),
    radial-gradient(ellipse at 85% 90%, rgba(168, 85, 247, 0.4), transparent 50%),
    linear-gradient(135deg, #3b1d6e, #22104a 55%, #2a1258);
  box-shadow:
    0 40px 110px rgba(0, 0, 0, 0.55),
    0 0 90px rgba(168, 85, 247, 0.22);
  overflow: hidden;
}

.cta-wave {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  opacity: 0.5;
}

.cta-inner {
  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  gap: 42px;
}

.cta-title {
  margin: 0;
  font: 600 clamp(34px, 4.6vw, 58px) / 1.08 var(--serif);
  letter-spacing: -0.03em;
  color: #fff;
}

.cta-sub {
  max-width: 420px;
  margin: 20px 0 0;
  font-size: 16px;
  line-height: 1.7;
  color: rgba(246, 231, 255, 0.78);
}

.cta-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 14px;
}

/* ── Footer (§17) ───────────────────────────────────────────── */

.site-footer {
  padding: clamp(70px, 9vh, 110px) clamp(24px, 6vw, 88px) 34px;
  border-top: 1px solid rgba(255, 255, 255, 0.06);
  background: #0d0618;
}

.footer-inner {
  display: grid;
  grid-template-columns: 1.35fr 1.8fr 1.15fr;
  gap: clamp(36px, 5vw, 80px);
  max-width: 1180px;
  margin: 0 auto 64px;
}

.footer-brand p {
  margin: 18px 0 22px;
  max-width: 300px;
  font-size: 14px;
  line-height: 1.7;
  color: var(--hp-muted);
}

.footer-socials {
  display: flex;
  gap: 10px;
}

.footer-social {
  display: grid;
  place-items: center;
  width: 36px;
  height: 36px;
  border-radius: 10px;
  border: 1px solid rgba(255, 255, 255, 0.09);
  background: rgba(255, 255, 255, 0.03);
  color: var(--hp-secondary);
  transition: color 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
}

.footer-social:hover {
  color: var(--hp-accent-light);
  background: rgba(168, 85, 247, 0.12);
  border-color: rgba(168, 85, 247, 0.4);
}

.footer-cols {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 26px;
}

.footer-col h4,
.footer-newsletter h4 {
  margin: 0 0 16px;
  font: 600 12.5px var(--sans);
  letter-spacing: 1.6px;
  text-transform: uppercase;
  color: var(--hp-heading);
}

.footer-col ul {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  gap: 10px;
}

.footer-col a,
.footer-newsletter p {
  font-size: 13.5px;
  color: var(--hp-muted);
  transition: color 0.2s ease;
}

.footer-col a:hover {
  color: var(--hp-body);
}

.footer-newsletter p {
  margin: 0 0 18px;
  line-height: 1.6;
}

.footer-form {
  display: flex;
  align-items: center;
  border-radius: 12px;
  border: 1px solid rgba(255, 255, 255, 0.12);
  background: rgba(255, 255, 255, 0.04);
  padding: 5px 5px 5px 16px;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.footer-form:focus-within {
  border-color: rgba(168, 85, 247, 0.7);
  box-shadow: 0 0 0 3px rgba(168, 85, 247, 0.14);
}

.footer-form input {
  flex: 1;
  min-width: 0;
  background: transparent;
  border: 0;
  outline: none;
  color: var(--hp-heading);
  font: 400 14px var(--sans);
}

.footer-form input::placeholder {
  color: var(--hp-muted);
}

.footer-form button {
  width: 40px;
  height: 40px;
  flex-shrink: 0;
  display: grid;
  place-items: center;
  border-radius: 9px;
  border: 0;
  background: linear-gradient(135deg, var(--hp-primary), var(--hp-accent));
  color: #fff;
  font-size: 17px;
  cursor: pointer;
  transition: filter 0.2s ease;
}

.footer-form button:hover {
  filter: brightness(1.12);
}

.footer-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  max-width: 1180px;
  margin: 0 auto;
  padding-top: 26px;
  border-top: 1px solid rgba(255, 255, 255, 0.06);
  font-size: 12.5px;
  color: var(--hp-muted);
}

.footer-legal {
  display: inline-flex;
  gap: 22px;
}

.footer-legal a {
  color: var(--hp-muted);
  transition: color 0.2s ease;
}

.footer-legal a:hover {
  color: var(--hp-body);
}

/* ── Anchored sections ──────────────────────────────────────── */

#features,
#pricing,
#how-it-works,
#product {
  scroll-margin-top: 96px;
}

/* ── Responsive (§19) ───────────────────────────────────────── */

@media (max-width: 1100px) {
  .hero-inner {
    grid-template-columns: 1fr 1fr;
  }

  .agent-card {
    right: -10px;
  }

  .an-inner {
    grid-template-columns: 1fr;
  }

  .an-copy .section-heading {
    max-width: 620px;
  }

  .metric-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .feature-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}

@media (max-width: 900px) {
  .site-nav-links {
    display: none;
  }

  .hero-inner,
  .bp-inner {
    grid-template-columns: 1fr;
  }

  .hero-product {
    min-height: 0;
    margin-top: 40px;
  }

  /* Agent card becomes an inline block below the call card on tablet/mobile */
  .agent-card {
    position: static;
    transform: none;
    width: 100%;
    max-width: 420px;
    margin: 18px auto 0;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 14px;
    text-align: left;
    padding: 16px 18px;
  }

  .agent-head {
    grid-column: 1 / -1;
  }

  .agent-photo {
    margin: 0;
  }

  .agent-rating {
    margin-top: 0;
  }

  .agent-answer {
    grid-column: 1 / -1;
    margin-top: 2px;
  }

  .hero-orb {
    width: 560px;
    height: 560px;
    right: -30%;
  }

  .bp-blob {
    opacity: 0.7;
  }

  .browser-body {
    grid-template-columns: 46px 1.2fr 1fr;
  }

  .feature-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .footer-inner {
    grid-template-columns: 1fr 1fr;
  }

  .hiw-steps {
    grid-template-columns: repeat(2, 1fr);
    row-gap: 44px;
  }

  .hiw-node:nth-child(5) {
    grid-column: 1 / -1;
    max-width: 50%;
  }

  .hiw-line {
    display: none;
  }
}

@media (max-width: 640px) {
  .site-nav-inner {
    padding: 12px 14px;
  }

  .site-nav-auth {
    gap: 10px;
  }

  .site-nav-login {
    display: none;
  }

  .site-nav-cta {
    padding: 9px 14px;
    font-size: 12.5px;
  }

  .logo {
    gap: 8px;
  }

  .logo-word {
    font-size: 13px;
    letter-spacing: 1.8px;
  }

  .hero {
    padding-top: 130px;
  }

  .hero-title {
    font-size: clamp(38px, 11vw, 52px);
  }

  .hero-sub {
    font-size: 15.5px;
  }

  .hero-actions .cc-btn {
    width: 100%;
  }

  .call-card {
    width: 100%;
  }

  .browser-body {
    grid-template-columns: 40px 1fr;
  }

  .browser-notes {
    grid-column: 1 / -1;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .an-bottom {
    grid-template-columns: 1fr;
  }

  .feature-grid {
    grid-template-columns: 1fr;
  }

  .plan-grid {
    grid-template-columns: 1fr;
  }

  .plan-card.featured {
    order: -1;
  }

  .footer-inner {
    grid-template-columns: 1fr;
  }

  .footer-cols {
    grid-template-columns: repeat(2, 1fr);
  }

  .footer-bottom {
    flex-direction: column;
    align-items: flex-start;
  }

  .cta-inner {
    grid-template-columns: 1fr;
    gap: 28px;
    text-align: center;
  }

  .cta-sub {
    margin-inline: auto;
  }

  .cta-actions {
    justify-content: center;
  }

  .trust-row {
    gap: 16px 28px;
  }

  .trust-logo {
    font-size: 13.5px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .homepage {
    scroll-behavior: auto;
  }

  .hero-orb,
  .hero-light,
  .hero-spotlight,
  .hero-horizon {
    animation: none;
  }
}

/* ── Desktop reference calibration ─────────────────────────────
   Screenshot target: content lives inside disciplined viewport frames.
   These rules deliberately override earlier generous marketing defaults.
   ───────────────────────────────────────────────────────────── */
@media (min-width: 901px) {
  .homepage {
    background:
      radial-gradient(ellipse 72% 34% at 50% 0%, rgba(87, 35, 168, 0.15), transparent 70%),
      #080510;
  }

  .section-heading {
    font-size: clamp(34px, 3.1vw, 48px);
    line-height: 1.08;
  }

  .hero {
    height: 100svh;
    min-height: 660px;
    padding: 108px clamp(40px, 5vw, 72px) 32px;
    background: #07040d;
  }

  .hero-bg {
    background:
      radial-gradient(ellipse 44% 72% at 76% 25%, rgba(101, 46, 195, 0.14), transparent 70%),
      linear-gradient(180deg, rgba(8, 5, 16, 0.06), #07040d 92%);
  }

  .hero-orb {
    top: -31%;
    right: -6%;
    width: 760px;
    height: 760px;
    opacity: 0.82;
    filter: blur(4px);
    background:
      radial-gradient(circle at 41% 39%, rgba(243, 224, 255, 0.18), transparent 28%),
      radial-gradient(circle at 50% 50%, rgba(133, 65, 236, 0.48), rgba(55, 20, 109, 0.28) 54%, transparent 74%);
  }

  .hero-light {
    top: 29%;
    left: 42%;
    width: 560px;
    height: 330px;
    opacity: 0.65;
  }

  .hero-horizon {
    bottom: -20%;
    width: 118%;
    height: 330px;
    opacity: 0.88;
  }

  .hero-grid {
    opacity: 0.32;
    background-size: 96px 96px;
  }

  .hero-inner {
    height: 100%;
    max-width: 1240px;
    grid-template-columns: minmax(330px, 0.86fr) minmax(520px, 1.14fr);
    gap: clamp(28px, 4vw, 68px);
  }

  .hero-eyebrow {
    margin-bottom: 18px;
    padding: 7px 12px;
    font-size: 10px;
    letter-spacing: 1.6px;
  }

  .hero-title {
    font-size: clamp(42px, 3.65vw, 60px);
    line-height: 1.07;
    letter-spacing: -0.048em;
  }

  .hero-sub {
    max-width: 420px;
    margin-top: 18px;
    font-size: 14px;
    line-height: 1.68;
  }

  .hero-actions {
    margin-top: 26px;
    gap: 12px;
  }

  .hero-actions .cc-btn {
    padding: 13px 22px;
    font-size: 13.5px;
  }

  .hero-trust {
    gap: 8px 22px;
    margin-top: 20px;
  }

  .hero-trust li {
    margin: 0;
    font-size: 11px;
  }

  .hero-product {
    min-height: 560px;
    transform: none;
  }

  .call-card {
    width: min(430px, 84%);
    padding: 22px;
    border-radius: 18px;
  }

  .call-contact {
    margin: 16px 0 14px;
  }

  .call-avatar {
    width: 46px;
    height: 46px;
  }

  .call-contact strong {
    font-size: 16px;
  }

  .call-contact small {
    font-size: 12.5px;
  }

  .call-ctl {
    padding: 10px 8px;
    font-size: 12px;
  }

  .agent-card {
    right: 6px;
    width: 220px;
    padding: 18px;
    border-radius: 16px;
  }

  .agent-photo {
    width: 72px;
    height: 72px;
    margin: 14px auto 10px;
  }

  .agent-meta strong {
    font-size: 15px;
  }

  .agent-meta small {
    font-size: 11.5px;
  }

  .agent-answer {
    margin-top: 14px;
    padding: 11px;
    font-size: 13.5px;
  }

  .trust {
    padding: 18px clamp(40px, 5vw, 72px) 24px;
    background: #080510;
  }

  .trust-label {
    margin-bottom: 17px;
    font-size: 9px;
    letter-spacing: 2.4px;
  }

  .trust-row {
    flex-wrap: nowrap;
    justify-content: space-between;
    gap: 18px;
    max-width: 1120px;
  }

  .trust-logo {
    gap: 7px;
    font-size: 12px;
  }

  .trust-logo svg {
    width: 15px;
    height: 15px;
  }

  .hiw {
    min-height: 100svh;
    box-sizing: border-box;
    display: grid;
    align-content: center;
    padding: 96px clamp(40px, 5vw, 72px) 70px;
    background: #080510;
  }

  .hiw-head {
    max-width: none;
    margin: 0 0 52px;
    text-align: center;
  }

  .hiw-head .section-eyebrow {
    margin-bottom: 12px;
    font-size: 9px;
    letter-spacing: 2.2px;
  }

  .hiw-head .section-eyebrow::before {
    display: none;
  }

  .hiw-track {
    width: min(1120px, 100%);
    margin: 0 auto;
    padding-top: 0;
  }

  .hiw-line {
    top: 37px;
  }

  .hiw-steps {
    gap: 22px;
  }

  .hiw-node {
    text-align: center;
  }

  .hiw-node-top {
    flex-direction: column;
    gap: 12px;
    margin-bottom: 14px;
  }

  .hiw-icon {
    width: 74px;
    height: 74px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, rgba(168, 85, 247, 0.3), rgba(18, 8, 37, 0.96) 68%);
    box-shadow: 0 0 0 1px rgba(168, 85, 247, 0.16), 0 0 28px rgba(122, 62, 242, 0.2);
  }

  .hiw-icon svg {
    width: 29px;
    height: 29px;
  }

  .hiw-num {
    font-size: 10px;
  }

  .hiw-copy h3 {
    margin-bottom: 8px;
    font-size: 14px;
  }

  .hiw-copy p {
    max-width: 180px;
    margin: 0 auto;
    font-size: 11px;
    line-height: 1.6;
  }

  .bp,
  .analytics {
    min-height: 100svh;
    box-sizing: border-box;
    display: grid;
    align-items: center;
    padding: 94px clamp(40px, 5vw, 72px) 68px;
    background: #080510;
  }

  .bp-inner,
  .an-inner {
    width: min(1160px, 100%);
    max-width: none;
    gap: clamp(34px, 4vw, 64px);
  }

  .bp-inner {
    grid-template-columns: minmax(260px, 0.72fr) minmax(620px, 1.28fr);
  }

  .an-inner {
    grid-template-columns: minmax(260px, 0.72fr) minmax(650px, 1.28fr);
    align-items: center;
  }

  .bp .section-eyebrow,
  .analytics .section-eyebrow {
    margin-bottom: 12px;
    font-size: 9px;
    letter-spacing: 2px;
  }

  .bp-heading,
  .an-heading {
    margin-bottom: 14px;
    font-size: clamp(34px, 3vw, 46px);
  }

  .bp-body,
  .an-body {
    margin-bottom: 18px;
    max-width: 330px;
    font-size: 12px;
    line-height: 1.65;
  }

  .check-list {
    margin-bottom: 20px;
    gap: 10px;
  }

  .check-list li {
    font-size: 11px;
  }

  .text-link-arrow {
    font-size: 11px;
  }

  .bp-browser {
    max-width: 820px;
    justify-self: end;
    transform: none;
  }

  .browser-bar {
    min-height: 42px;
  }

  .browser-body {
    min-height: 380px;
  }

  .an-dash {
    gap: 12px;
  }

  .metric-grid,
  .an-bottom {
    gap: 12px;
  }

  .metric-card {
    padding: 18px 20px;
  }

  .metric-label {
    font-size: 10px;
    letter-spacing: 1.2px;
  }

  .metric-value {
    margin: 10px 0 8px;
    font-size: 26px;
  }

  .metric-delta {
    font-size: 10px;
  }

  .chart-panel,
  .campaigns-panel {
    padding: 18px;
  }

  .features,
  .pricing {
    min-height: 100svh;
    box-sizing: border-box;
    display: grid;
    align-content: center;
    padding: 96px clamp(40px, 5vw, 72px) 70px;
    background: #080510;
  }

  .features-head,
  .pricing-head {
    margin-bottom: 34px;
  }

  .features-head .section-eyebrow,
  .pricing-head .section-eyebrow {
    margin-bottom: 10px;
    font-size: 9px;
    letter-spacing: 2px;
  }

  .features-head .section-heading,
  .pricing-head .section-heading {
    font-size: clamp(32px, 2.7vw, 42px);
  }

  .feature-grid {
    gap: 12px;
    max-width: 1120px;
  }

  .feat-card {
    min-height: 224px;
    padding: 24px 20px;
    border-radius: 14px;
  }

  .feat-icon {
    width: 46px;
    height: 46px;
    margin-bottom: 18px;
    border-radius: 12px;
  }

  .feat-card h3 {
    margin-bottom: 8px;
    font-size: 14px;
  }

  .feat-card p {
    font-size: 11.5px;
    line-height: 1.58;
  }

  .plan-grid {
    max-width: 1020px;
    gap: 18px;
  }

  .plan-card {
    min-height: 400px;
    padding: 28px 26px;
    border-radius: 16px;
  }

  .plan-card h3 {
    margin-bottom: 10px;
    font-size: 13px;
  }

  .plan-price {
    font-size: 40px;
  }

  .plan-price span {
    font-size: 13px;
  }

  .plan-blurb {
    margin: 10px 0 20px;
    font-size: 11px;
  }

  .plan-features {
    margin-bottom: 22px;
    gap: 10px;
  }

  .plan-features li {
    gap: 8px;
    font-size: 11px;
  }

  .plan-cta {
    min-height: 38px;
    padding: 10px 14px;
    font-size: 11px;
  }

  .plan-footnote {
    margin-top: 20px;
    font-size: 11px;
  }

  .cta {
    padding: 54px clamp(40px, 5vw, 72px) 72px;
    background: #080510;
  }

  .cta-banner {
    max-width: 1120px;
    padding: 48px 64px;
    border-radius: 22px;
  }

  .cta-inner {
    gap: 32px;
  }

  .cta-title {
    font-size: clamp(28px, 2.6vw, 40px);
  }

  .cta-sub {
    max-width: 310px;
    margin-top: 10px;
    font-size: 10px;
    line-height: 1.55;
  }

  .cta-actions .cc-btn {
    min-height: 42px;
    padding: 10px 18px;
    font-size: 11px;
  }
}
