# Copy to .env and fill in real values. Never commit .env.

# --- Core ---
DATABASE_URL=postgres://user:pass@host:5432/db
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Auth (better-auth) ---
# REQUIRED in production — the app refuses to start without it (no fallback secret).
BETTER_AUTH_SECRET=generate-with-openssl-rand-hex-32
BETTER_AUTH_URL=http://localhost:3000

# --- One-time bootstrap ---
# Optional. Set this to lock /api/v1/setup/make-admin behind a token you pass
# with `x-setup-token: <token>`. Leave unset to allow the endpoint only until
# the first super admin exists (then it hard-403s).
# SETUP_TOKEN=

# --- Realtime gateway (socket.io) ---
# REQUIRED in production. Must match between the Next server and the gateway.
# Without it, /publish is disabled in production and socket joins are still
# session-authenticated. Same value on both processes.
# GATEWAY_PUBLISH_TOKEN=generate-a-long-random-string
GATEWAY_URL=http://localhost:3001
NEXT_PUBLIC_REALTIME_URL=http://localhost:3001
REALTIME_PORT=3001
REDIS_URL=redis://localhost:6379

# --- Call routing ---
# Set to 1 to route inbound calls asynchronously: the webhook returns 202 and
# the worker's route-call job dials the agent. Requires the worker running.
# Leave unset for inline routing (dev default).
# CALL_ROUTING_ASYNC=1

# --- Telephony (Telnyx) ---
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=
TELNYX_PUBLIC_KEY=
TELNYX_WEBRTC_CONNECTION_ID=
TELNYX_WEBRTC_SIP_USER=
TELNYX_WEBRTC_SIP_REALM=sip.telnyx.com
TELNYX_WEBRTC_SIP_PASSWORD=

# --- Retreaver ---
RETREAVER_API_KEY=
RETREAVER_COMPANY_ID=
RETREAVER_WEBHOOK_SECRET=

# --- Email ---
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Billing ---
ENCRYPTION_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Misc ---
# Set to 1 to log one concise line per telephony webhook event (no payloads).
WEBHOOK_DEBUG=
APP_BASE_URL=http://localhost:3000
